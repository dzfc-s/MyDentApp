# Kopiraj ovaj fajl u .env i popuni stvarnim vrijednostima. .env se NIKAD ne commituje.
# Vrijednosti sa specijalnim znakovima MORAJU biti pod navodnicima.

# Docker / SQL Server
DB_SA_PASSWORD="ChangeMe123!"
DB_PORT=1435

# Docker / RabbitMQ
RABBITMQ_USER="mydent"
RABBITMQ_PASSWORD="ChangeMe123!"
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ASP.NET Core / Worker config for RabbitMQ (dupli underscore = separator za ugniježđene sekcije).
# HostName je "localhost" za pokretanje van Dockera (dotnet run); docker-compose.yml ovo
# prepisuje na ime kontejnera kad API/worker rade unutar mreže.
RabbitMQ__HostName="localhost"
RabbitMQ__Port=5672
RabbitMQ__UserName="mydent"
RabbitMQ__Password="ChangeMe123!"
RabbitMQ__NotificationsQueueName="appointment-notifications"

# ASP.NET Core konfiguracija (dupli underscore = separator za ugniježđene sekcije)
ConnectionStrings__DefaultConnection="Server=localhost,1435;Database=210057;User Id=sa;Password=ChangeMe123!;TrustServerCertificate=True;"
JwtToken__Audience="http://MyDent.com"
JwtToken__Issuer="https://MyDent.com"
JwtToken__SecretKey="ReplaceWithALongRandomSecretString"
JwtToken__DurationInMinutes=30

# Stripe test-mode secret key (dashboard.stripe.com -> Developers -> API keys -> Secret key, test mode)
Stripe__SecretKey="sk_test_ReplaceWithYourStripeTestSecretKey"
